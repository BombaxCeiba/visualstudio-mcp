<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- 限 C# 9：net48 可用 C# 9（record/init-only/target-typed new/nullable/pattern matching/
         using var/out var 均在 C# 9 范围内）。不上 C# 10+ 以保证 VSIX 在多版本 VS 宿主上一致编译。 -->
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <RootNamespace>VsMcp</RootNamespace>
    <AssemblyName>VsMcp</AssemblyName>
    <!-- Strong-name-sign the assembly so the ProvideCodeBase codeBase entry
         in the generated pkgdef loads cleanly. Without a strong name the CLR
         refuses a codeBase located outside the VS application base
         (HRESULT 0x80131041) and the package fails to load. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>VsMcp.snk</AssemblyOriginatorKeyFile>
    <!-- Suppress warnings from packages that don't declare net48 support -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- Disable auto-generated AssemblyInfo since we have an explicit one -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Default VS SDK assembly path for command-line builds.
         Multi-target policy: prefer the OLDEST installed VS so the compiled
         IL binds against the lowest SDK metadata, keeping the VSIX loadable
         on every targeted VS version. The default below points at VS2022
         (Dev17) to match the [17.0,18.0) installation target in vsixmanifest.
         If that path is missing on this machine, ResolveVsSdkPath (below)
         uses vswhere to discover whatever VS is installed and falls back to it. -->
    <VsWherePath Condition=" '$(VsWherePath)' == '' ">$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWherePath>
    <VsSdkAssembliesPath Condition=" '$(VsSdkAssembliesPath)' == '' ">C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\PublicAssemblies</VsSdkAssembliesPath>
    <!-- Generate pkgdef from [PackageRegistration]/[ProvideAutoLoad] attributes (we ship a real VS Package) -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!-- Produce the .vsix container via the VS SDK build tooling (full MSBuild only — not dotnet build) -->
    <GenerateVsixContainer>true</GenerateVsixContainer>
    <CopyVsixManifestToOutput>true</CopyVsixManifestToOutput>
    <!-- Import the VS SDK core targets (defines CreateVsixContainer/GeneratePkgDef). VSSDK.BuildTools.props sets VsSDKInstall to the package's tools folder. -->
    <CustomAfterMicrosoftCSharpTargets Condition="'$(VsSDKInstall)' != ''">$(VsSDKInstall)\Microsoft.VsSDK.targets</CustomAfterMicrosoftCSharpTargets>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- eval_csharp 编译开关：本地开发默认启用（动态 C# 执行，调试利器）；
       GitHub 发布管线（.github/workflows/release.yml）用 /p:EvalCsharpEnabled=false
       显式关闭，发布版 VSIX 完全不含 eval_csharp 代码（任意代码执行，不应进生产）。
       EvalCsharpFacade / eval_csharp 工具注册 / EnableEvalCsharp 开关 / 参数链路
       全部 #if EVAL_CSHARP 包裹。 -->
  <PropertyGroup>
    <EvalCsharpEnabled Condition=" '$(EvalCsharpEnabled)' == '' ">true</EvalCsharpEnabled>
    <DefineConstants Condition=" '$(EvalCsharpEnabled)' == 'true' ">$(DefineConstants);EVAL_CSHARP</DefineConstants>
  </PropertyGroup>

  <!-- NuGet Package References。
       架构反转后 VS 包不再引 MCP SDK（MCP 移至 Gateway 进程，VS 包退化为工具后端，
       代码已无任何 ModelContextProtocol 类型引用）。
       System.Text.Json 降到 10.0.0（assembly version 10.0.0.0）：18.5.2 host 的
       bindingRedirect range ≤10.0.0.2，引 10.0.0.0 落在范围内被 host redirect 接受，
       运行时用 host 的 System.Text.Json；旧引 10.0.9（=10.0.0.9 > 10.0.0.2）被 host
       压制 → 0x80131040。STJ copy-local 供 CreatePkgDef 加载，但不打包进 VSIX
       （ForceIncludeRuntimeDependencies 改从 Gateway 输出目录打包 10.0.9 给 Gateway；
       VsMcp.dll 运行时走 host codeBase 的 STJ，不用 VSIX 副本）。Gateway 是独立进程，
       不受 host redirect 管辖，保持 10.0.9。Microsoft.Extensions.Logging.Abstractions
       引 host PublicAssemblies（Private=false，与 Shell.15.0 同模式），运行时用 host 的；
       删 MCP 后此引用不再由 MCP 传递，需单独 host Reference。 -->
  <ItemGroup>
    <!-- Microsoft.VisualStudio.Threading is intentionally NOT a PackageReference:
         binding a NuGet version (e.g. 17.14.15) against an SDK Shell.15.0 from a
         different VS install triggers CS1705 (Threading 17.x vs Shell's internal
         reference to Threading 18.x). Instead we resolve the dll from the same
         VS install that provides Shell.15.0 via ResolveThreadingReference below. -->
    <!-- STJ 用 Reference（非 PackageReference）：PackageReference 会传递 Microsoft.Bcl.AsyncInterfaces
         10.0.0.0，与下方 host Bcl 10.0.0.4 重复 → CS0433。改 Reference 不传递依赖。
         引 NuGet 10.0.0 dll（assembly 10.0.0.0 ≤ 18.5.2 host STJ redirect range 10.0.0.2，
         被 host redirect 接受），Private=false 不 copy-local，运行时用 host 的 STJ
         （host redirect 10.0.0.0→10.0.0.2 on 18.5.2 / 10.0.0.4 on 18.7）。 -->
    <Reference Include="System.Text.Json">
      <HintPath>$(NuGetPackageRoot)system.text.json\10.0.0\lib\net462\System.Text.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VS SDK build tooling: turns source.extension.vsixmanifest into an installable .vsix on build -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
  </ItemGroup>

  <!-- Discover VS SDK path via vswhere when the default path (VS2022) is absent.
       -sort by major version ascending would be ideal, but vswhere lacks ascending
       sort, so we list all matching installs and pick the FIRST (vswhere default
       sort is version-descending; we work around by querying oldest-first via
       separate version-range calls). -->
  <Target Name="ResolveVsSdkPath" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Shell.15.0.dll') And Exists('$(VsWherePath)')">
    <!-- Try VS2022 first (Dev17, oldest targeted). -->
    <Exec Command='"$(VsWherePath)" -version "[17.0,18.0)" -property installationPath'
          ConsoleToMSBuild="true" Condition=" '$(_Vs2022Path)' == '' ">
      <Output TaskParameter="ConsoleOutput" PropertyName="_Vs2022Path" />
    </Exec>
    <PropertyGroup Condition=" '$(_Vs2022Path)' != '' ">
      <_VsInstallPath>$(_Vs2022Path)</_VsInstallPath>
    </PropertyGroup>
    <!-- Fall back to VS2026 (Dev18) if VS2022 is absent. -->
    <Exec Command='"$(VsWherePath)" -version "[18.0,19.0)" -property installationPath'
          ConsoleToMSBuild="true" Condition=" '$(_VsInstallPath)' == '' ">
      <Output TaskParameter="ConsoleOutput" PropertyName="_Vs2026Path" />
    </Exec>
    <PropertyGroup Condition=" '$(_VsInstallPath)' == '' And '$(_Vs2026Path)' != '' ">
      <_VsInstallPath>$(_Vs2026Path)</_VsInstallPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(_VsInstallPath)' != '' ">
      <VsSdkAssembliesPath>$(_VsInstallPath)\Common7\IDE\PublicAssemblies</VsSdkAssembliesPath>
    </PropertyGroup>
    <Warning Text="[VsMcp] VS2022 not found on this machine; falling back to $(_VsInstallPath) — the compiled VSIX may not load on VS2022 if the code calls APIs added after Dev17." Condition=" '$(_VsInstallPath)' != '' And '$(_Vs2022Path)' == '' " />
    <Error Text="[VsMcp] No Visual Studio installation found via vswhere. Install VS2022 or VS2026, or pass /p:VsSdkAssembliesPath=..." Condition=" '$(_VsInstallPath)' == '' " />
    <Message Text="[VsMcp] Resolved VS SDK via vswhere: $(VsSdkAssembliesPath)" Importance="high" Condition=" '$(_VsInstallPath)' != '' " />
  </Target>

  <!-- Bind Microsoft.VisualStudio.Threading to the SAME VS install that provides
       Shell.15.0 — this prevents CS1705 by aligning the Threading metadata
       version with whatever Shell.15.0 internally references.
       VS2022 layout: PublicAssemblies\Microsoft.VisualStudio.Threading.dll
       VS2026 layout: PublicAssemblies\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll
                     (the subdir name suggests 17.x but the dll inside is actually 18.x;
                      that's intentional — VS2026 ships a Threading whose API surface
                      still covers the 17.x contract). -->
  <Target Name="ResolveThreadingReference" BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="ResolveVsSdkPath">
    <PropertyGroup>
      <_ThreadingHintPath Condition="Exists('$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Threading.dll')">$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Threading.dll</_ThreadingHintPath>
      <_ThreadingHintPath Condition=" '$(_ThreadingHintPath)' == '' And Exists('$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll')">$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll</_ThreadingHintPath>
    </PropertyGroup>
    <ItemGroup Condition=" '$(_ThreadingHintPath)' != '' ">
      <Reference Include="Microsoft.VisualStudio.Threading">
        <HintPath>$(_ThreadingHintPath)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
    <Error Text="[VsMcp] Microsoft.VisualStudio.Threading.dll not found under $(VsSdkAssembliesPath) (looked at root and Microsoft.VisualStudio.Threading.17.x\)" Condition=" '$(_ThreadingHintPath)' == '' " />
    <Message Text="[VsMcp] Threading reference resolved to: $(_ThreadingHintPath)" Importance="high" />
  </Target>


  <!-- VS SDK Assembly References (from VS installation).
       These MUST be created inside a Target (not a static ItemGroup) so that
       VsSdkAssembliesPath — potentially rewritten by ResolveVsSdkPath — is
       evaluated at reference-resolution time, not at csproj load time. -->
  <Target Name="ResolveVsSdkReferences" BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="ResolveVsSdkPath;ResolveThreadingReference">
    <PropertyGroup>
      <!-- Common7\IDE root. NavigateTo.Interfaces and ComponentModelHost ship
           under CommonExtensions (not PublicAssemblies), so they need their own
           HintPath. Derived from the vswhere-resolved install, or — when the
           default VS2022 PublicAssemblies was used as-is — by stripping the
           trailing \PublicAssemblies off VsSdkAssembliesPath. -->
      <_VsIdePath Condition=" '$(_VsInstallPath)' != '' ">$(_VsInstallPath)\Common7\IDE</_VsIdePath>
      <_VsIdePath Condition=" '$(_VsIdePath)' == '' ">$(VsSdkAssembliesPath.Replace('\PublicAssemblies',''))</_VsIdePath>
    </PropertyGroup>
    <ItemGroup>
      <!-- NavigateTo (Ctrl+T / "Go To All") contract — powers find_symbol via
           INavigateToItemProviderFactory. C++ symbols are served through the VC
           Language Server's LSP workspace/symbol, aggregated by the same
           RemoteLanguageNavigateToItemProviderFactory VS itself uses. -->
      <Reference Include="Microsoft.VisualStudio.Language.NavigateTo.Interfaces">
        <HintPath>$(_VsIdePath)\CommonExtensions\Microsoft\NavigateTo\Microsoft.VisualStudio.Language.NavigateTo.Interfaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- LSP client 契约 —— find_symbol 经 ILanguageServiceBroker2 直接对 VC Language
           Server 发 workspace/symbol。公共 RequestAllAsync 路径内部会包含
           DisableUserExperience(true) 的 C++ 客户端（经典 NavigateTo v1 适配器会把它
           过滤掉，导致 0 结果），所以走 LSP 才能拿到 C++ 符号。 -->
      <Reference Include="Microsoft.VisualStudio.LanguageServer.Client">
        <HintPath>$(_VsIdePath)\CommonExtensions\Microsoft\LanguageServer\Microsoft.VisualStudio.LanguageServer.Client.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.LanguageServer.Client.Implementation">
        <HintPath>$(_VsIdePath)\CommonExtensions\Microsoft\LanguageServer\Microsoft.VisualStudio.LanguageServer.Client.Implementation.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.LanguageServer.Protocol">
        <HintPath>$(_VsIdePath)\CommonExtensions\Microsoft\LanguageServer\Microsoft.VisualStudio.LanguageServer.Protocol.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- VC 原生 CodeStore —— find_symbol 经 IVCNavigateToFactory 查 C++ 符号
           （Ctrl+T / SymbolScanner 的真正后端，in-proc COM，不经 LSP broker；
           LSP RequestAllAsync 对 C++ 永远 0，因为 C++ 不注册 broker client）。
           Private=false：VS host 自带，VSIX 不重复打包。 -->
      <Reference Include="Microsoft.VisualStudio.CppSvc.Internal">
        <HintPath>$(_VsIdePath)\PrivateAssemblies\Microsoft.VisualStudio.CppSvc.Internal.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.CodeStore.Internal">
        <HintPath>$(_VsIdePath)\PrivateAssemblies\Microsoft.VisualStudio.CodeStore.Internal.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- VCImageMoniker（IVCCallHierarchyMemberItem.GetData 的 out 参数）定义在此——
           get_call_graph 经 CallHierarchy API 查调用关系需要它。VS host 自带，Private=false。 -->
      <Reference Include="Microsoft.VisualStudio.VC.Interfaces">
        <HintPath>$(_VsIdePath)\PublicAssemblies\Microsoft.VisualStudio.VC.Interfaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- MEF composition host — IComponentModel (SComponentModel) is the way to
           reach MEF exports (the NavigateTo factories) from an AsyncPackage. -->
      <Reference Include="Microsoft.VisualStudio.ComponentModelHost">
        <HintPath>$(_VsIdePath)\CommonExtensions\Platform\MefHosting\Microsoft.VisualStudio.ComponentModelHost.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.Shell.15.0">
        <HintPath>$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Shell.15.0.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.Shell.Framework">
        <HintPath>$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Shell.Framework.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.OLE.Interop">
        <HintPath>$(VsSdkAssembliesPath)\Microsoft.VisualStudio.OLE.Interop.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.Shell.Interop.8.0">
        <HintPath>$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Shell.Interop.8.0.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.Shell.Interop">
        <HintPath>$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Shell.Interop.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.Interop">
        <HintPath>$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Interop.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- Microsoft.Extensions.Logging.Abstractions：VS 包用 ILoggerFactory/ILogger
           （PipeMcpServer/Logging 层）。删 MCP 后不再由 MCP 传递，引 host
           PublicAssemblies（Private=false，与 Shell.15.0 同模式），运行时用 host 的。 -->
      <Reference Include="Microsoft.Extensions.Logging.Abstractions">
        <HintPath>$(VsSdkAssembliesPath)\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- Microsoft.Bcl.AsyncInterfaces：IAsyncEnumerable<T>（SymbolFacade LSP
           RequestAllAsync 返回值）。host LanguageServer.Client.Implementation 引用
           10.0.0.3，NuGet 最高 10.0.0.0 低于它 → CS1705。引 host PublicAssemblies
           （Private=false），assembly 10.0.0.3 匹配 host。 -->
      <Reference Include="Microsoft.Bcl.AsyncInterfaces">
        <HintPath>$(VsSdkAssembliesPath)\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- VS 包代码直接用的 polyfill：System.Text.Encodings.Web（JavaScriptEncoder）、
           System.Threading.Tasks.Extensions（ValueTask）。删 MCP/STJ PackageReference 后
           不再由 NuGet 传递，引 host PublicAssemblies（Private=false，与 Shell.15.0 同模式）。 -->
      <Reference Include="System.Text.Encodings.Web">
        <HintPath>$(VsSdkAssembliesPath)\System.Text.Encodings.Web.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="System.Threading.Tasks.Extensions">
        <HintPath>$(VsSdkAssembliesPath)\System.Threading.Tasks.Extensions.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- Span/Memory polyfill 依赖链：STJ API（JsonDocument.Parse 等）用 ReadOnlySpan/
           ReadOnlyMemory，需 System.Memory；Memory 依赖 Buffers/Unsafe/Numerics.Vectors。 -->
      <Reference Include="System.Memory">
        <HintPath>$(VsSdkAssembliesPath)\System.Memory.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="System.Buffers">
        <HintPath>$(VsSdkAssembliesPath)\System.Buffers.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="System.Runtime.CompilerServices.Unsafe">
        <HintPath>$(VsSdkAssembliesPath)\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="System.Numerics.Vectors">
        <HintPath>$(VsSdkAssembliesPath)\System.Numerics.Vectors.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="System" />
      <Reference Include="System.Core" />
      <Reference Include="System.Net.Http" />
    </ItemGroup>
    <Message Text="[VsMcp] Resolved VS SDK references from $(VsSdkAssembliesPath)" Importance="high" />
  </Target>

  <!-- Pipe framing + protocol DTO source-link. The former VsMcp.Common DLL was
       removed because its NuGet-bound System.Text.Json version fought the VS
       host's codeBase-pinned version (FileLoadException on package load). The
       source is now compiled directly into VsMcp.dll (VS extension) and
       VsMcpGateway.exe (Gateway) so neither carries a shared DLL with strong-name
       / version / deployment constraints. The namespace stays VsMcp.Common, so
       every `using VsMcp.Common;` in this project resolves unchanged. -->
  <ItemGroup>
    <Compile Include="..\VsMcp.Common\PipeFraming.cs" Link="Common\PipeFraming.cs" />
    <Compile Include="..\VsMcp.Common\PipeProtocol.cs" Link="Common\PipeProtocol.cs" />
    <Compile Include="..\VsMcp.Common\ExtensionVersion.cs" Link="Common\ExtensionVersion.cs" />
  </ItemGroup>

  <!-- VsMcpGateway.exe is a separate WinExe process that owns :43210 and
       multiplexes MCP clients onto per-VS-instance pipes. It must ship inside
       this VSIX so that, after install, GatewayLauncher.ResolveGatewayPath's
       "same directory as the package dll" branch finds it next to VsMcp.dll.

       ReferenceOutputAssembly=false: VsMcp must NOT compile-link against the
       Gateway's types (different process; they only talk over pipes) — we use
       the ProjectReference purely to establish build ordering (Gateway must be
       built before VsMcp so its exe output exists for the Copy step below). -->
  <ItemGroup>
    <ProjectReference Include="..\VsMcpGateway\VsMcpGateway.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- After the Gateway project builds (driven by the ProjectReference above),
       copy its exe AND its generated .exe.config into VsMcp's output directory.
       The .exe.config is the SDK's auto-generated bindingRedirect output
       (AutoGenerateBindingRedirects=true), needed at runtime for any minor
       version unification inside the Gateway's own dependency graph. The
       bundled dependency dlls (System.Text.Json, System.Memory, etc.) come from
       VsMcp's own copy-local set, which — because VsMcp pins System.Text.Json
       10.0.9 directly — match Gateway's compile-time references, so the VSIX's
       single bundled System.Text.Json.dll satisfies both processes without
       extra manual bindingRedirects. -->
  <Target Name="CopyGatewayExe" AfterTargets="ResolveProjectReferences"
          BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <VsMcpGatewayOutputDir>$(MSBuildThisFileDirectory)..\VsMcpGateway\bin\$(Configuration)\net48\</VsMcpGatewayOutputDir>
      <VsMcpGatewayExePath>$(VsMcpGatewayOutputDir)VsMcpGateway.exe</VsMcpGatewayExePath>
      <VsMcpGatewayConfigPath>$(VsMcpGatewayOutputDir)VsMcpGateway.exe.config</VsMcpGatewayConfigPath>
    </PropertyGroup>
    <Copy SourceFiles="$(VsMcpGatewayExePath)"
          DestinationFolder="$(TargetDir)"
          Condition="Exists('$(VsMcpGatewayExePath)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(VsMcpGatewayConfigPath)"
          DestinationFolder="$(TargetDir)"
          Condition="Exists('$(VsMcpGatewayConfigPath)')"
          SkipUnchangedFiles="true" />
    <Message Text="Copied VsMcpGateway.exe + .exe.config -> $(TargetDir)" Importance="high"
             Condition="Exists('$(VsMcpGatewayExePath)')" />
    <Warning Text="VsMcpGateway.exe not found at $(VsMcpGatewayExePath) — Gateway will be MISSING from the VSIX"
             Condition="!Exists('$(VsMcpGatewayExePath)')" />
  </Target>

  <!-- source.extension.vsixmanifest is auto-detected by VSSDK.BuildTools; no explicit include needed -->

  <!--
    Force-include Gateway-side runtime files into the VSIX root next to
    VsMcpGateway.exe. These are NOT for the VS extension itself: VsMcp.dll runs
    inside the VS host, whose devenv.exe.config codeBase already pins
    System.Text.Json / System.Memory / etc. from VS SharedAssemblies. The VS
    extension loader honors the host codeBase and ignores these copies.

    The Gateway is a SEPARATE process (VsMcpGateway.exe) and needs its own
    private copies of these dlls + its .exe.config (bindingRedirects that the
    Gateway's GenerateBindingRedirectsOutputType produces) to launch
    successfully. After VSIX install everything lands in one directory, so the
    Gateway exe finds its config and dependencies next to itself.
    Must run before GetVsixSourceItems; Link= forces VSIX-root placement.
  -->
  <Target Name="ForceIncludeRuntimeDependencies" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <VsMcpGatewayOutputDir>$(MSBuildThisFileDirectory)..\VsMcpGateway\bin\$(Configuration)\net48\</VsMcpGatewayOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- VsMcpGateway.exe + .exe.config 从 $(TargetDir)（CopyGatewayExe 已拷来）。
           config 必带：否则 Gateway 启动 System.Memory 4.0.2.0 vs 4.0.5.0 FileLoadException。 -->
      <Content Include="$(TargetDir)VsMcpGateway.exe" Condition="Exists('$(TargetDir)VsMcpGateway.exe')">
        <IncludeInVSIX>true</IncludeInVSIX><Link>VsMcpGateway.exe</Link>
      </Content>
      <Content Include="$(TargetDir)VsMcpGateway.exe.config" Condition="Exists('$(TargetDir)VsMcpGateway.exe.config')">
        <IncludeInVSIX>true</IncludeInVSIX><Link>VsMcpGateway.exe.config</Link>
      </Content>
      <!-- Gateway 运行时依赖从 Gateway 输出目录打包全套。架构反转后 VS 包 polyfill 引 host
           （Private=false 不 copy-local），$(TargetDir) 无这些 dll；Gateway 是独立进程，自带
           MCP/STJ 10.0.9 + 传递依赖全套。VsMcp.dll 运行时用 host polyfill（codeBase 优先），
           不用这些 VSIX 副本。通配 *.dll 确保全套（含 Microsoft.Extensions.* 等 MCP 传递依赖），
           不漏；CreatePkgDef 在本 target 之前跑，$(TargetDir) 干净不受影响。 -->
      <Content Include="$(VsMcpGatewayOutputDir)*.dll">
        <IncludeInVSIX>true</IncludeInVSIX><Link>%(Filename)%(Extension)</Link>
      </Content>
    </ItemGroup>
    <Message Text="ForceIncludeRuntimeDependencies: bundling Gateway runtime deps from $(VsMcpGatewayOutputDir)" Importance="high" />
  </Target>

</Project>
