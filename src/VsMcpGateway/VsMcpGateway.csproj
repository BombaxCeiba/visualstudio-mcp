<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 独立 Gateway 进程，独占 :43210，作为所有 MCP 客户端的唯一入口。
         核心包 ModelContextProtocol 1.2.0 目标 netstandard2.0，net48 可用。 -->
    <TargetFramework>net48</TargetFramework>
    <!-- WinExe: 不创建控制台窗口（CREATE_NO_WINDOW 的等价物），用户无感知。 -->
    <OutputType>WinExe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <RootNamespace>VsMcpGateway</RootNamespace>
    <AssemblyName>VsMcpGateway</AssemblyName>
    <!-- 纯转发进程，不承载 VS Package，无需 VSSDK.BuildTools / VSIX 容器。 -->

    <!-- Auto-generate bindingRedirects into VsMcpGateway.exe.config at build
         time. The Gateway ships its own copy of System.Text.Json 10.0.9 (which
         depends on System.Memory 4.0.2.0), but net48's System.Memory 4.0.5.0
         also floats around — without these redirects the Gateway process hits
         a System.Memory FileLoadException on launch. The VSIX-bundled copy of
         this .exe.config (see VsMcp.csproj ForceIncludeRuntimeDependencies) is
         what makes the post-install Gateway actually startable. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pipe framing + protocol DTO source-link (former VsMcp.Common project).
         Same rationale as VsMcp.csproj: removing the shared DLL eliminates its
         NuGet-bound System.Text.Json version fighting the consumer's host.
         Namespace stays VsMcp.Common so every `using VsMcp.Common;` is
         unchanged. -->
    <Compile Include="..\VsMcp.Common\PipeFraming.cs" Link="Common\PipeFraming.cs" />
    <Compile Include="..\VsMcp.Common\PipeProtocol.cs" Link="Common\PipeProtocol.cs" />
    <Compile Include="..\VsMcp.Common\ExtensionVersion.cs" Link="Common\ExtensionVersion.cs" />
    <!-- 工具描述表：Gateway 本地构造 tools/list 响应时读它（不转发 VS）。
         工具名与 VS 端 ToolExecutor 的 case 一一对应。 -->
    <Compile Include="..\VsMcp.Common\ToolSchema.cs" Link="Common\ToolSchema.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 核心 MCP SDK（netstandard2.0，net48 可用）。StreamableHttpServerTransport
         提供标准 MCP server 支持，SDK 自动处理 initialize/tools-list/ping/notification。 -->
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <!-- Gateway 独立进程，需要自己的 System.Text.Json 副本（与 VS host 的 codeBase 隔离）。
         ModelContextProtocol 传递依赖此包，显式 pin 与 VS 同款。 -->
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
  </ItemGroup>

</Project>
