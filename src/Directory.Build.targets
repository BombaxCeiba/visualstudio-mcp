<Project>
  <!-- 单一真相源：从 Directory.Build.props 的 $(VsMcpVersion) 生成 Assembly 元数据 attributes。
       VsMcp.csproj 设 GenerateAssemblyInfo=false（用手写 AssemblyInfo.cs），SDK 不自动生成，
       故此处补生成 AssemblyVersion / AssemblyFileVersion / AssemblyInformationalVersion。
       Gateway 默认 GenerateAssemblyInfo=true，SDK 会从 props 自动生成，再补会 CS0579 重复。 -->
  <Target Name="GenerateInformationalVersionAttribute" BeforeTargets="BeforeCompile"
          Condition=" '$(GenerateAssemblyInfo)' == 'false' ">
    <WriteInfoVersionAttribute File="$(IntermediateOutputPath)$(MSBuildProjectName).InformationalVersion.g.cs" Version="$(VsMcpVersion)" AssemblyVersion="$(AssemblyVersion)" FileVersion="$(FileVersion)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)$(MSBuildProjectName).InformationalVersion.g.cs" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="WriteInfoVersionAttribute" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
      <AssemblyVersion ParameterType="System.String" Required="true" />
      <FileVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var dir = System.IO.Path.GetDirectoryName(File);
        if (!System.IO.Directory.Exists(dir)) System.IO.Directory.CreateDirectory(dir);
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("[assembly: System.Reflection.AssemblyInformationalVersion(\"" + Version + "\")]");
        sb.AppendLine("[assembly: System.Reflection.AssemblyVersion(\"" + AssemblyVersion + "\")]");
        sb.AppendLine("[assembly: System.Reflection.AssemblyFileVersion(\"" + FileVersion + "\")]");
        System.IO.File.WriteAllText(File, sb.ToString());
      ]]></Code>
    </Task>
  </UsingTask>
</Project>
