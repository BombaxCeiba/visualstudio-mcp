<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 so both the net48 VSIX (VsMcp) and the net48 Gateway
         exe (VsMcpGateway) can reference this without either dragging in the
         other's VS-SDK dependencies. Carries zero VS-SDK references itself. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <RootNamespace>VsMcp.Common</RootNamespace>
    <AssemblyName>VsMcp.Common</AssemblyName>
    <!-- A library shared by two apps; never pack the PDB alongside. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON framing payload + DTO (de)serialization. Aligned with VsMcp's
         System.Text.Json version so both sides serialize JsonRpcMessage identically. -->
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
  </ItemGroup>

</Project>
