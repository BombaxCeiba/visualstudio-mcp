<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- 限 C# 9：net48 可用 C# 9（record/init-only/target-typed new/nullable/pattern matching/
         using var/out var 均在 C# 9 范围内）。不上 C# 10+ 以保证 VSIX 在多版本 VS 宿主上一致编译。 -->
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <RootNamespace>VsMcp</RootNamespace>
    <AssemblyName>VsMcp</AssemblyName>
    <!-- Strong-name-sign the assembly so the ProvideCodeBase codeBase entry
         in the generated pkgdef loads cleanly. Without a strong name the CLR
         refuses a codeBase located outside the VS application base
         (HRESULT 0x80131041) and the package fails to load. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>VsMcp.snk</AssemblyOriginatorKeyFile>
    <!-- Suppress warnings from packages that don't declare net48 support -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- Disable auto-generated AssemblyInfo since we have an explicit one -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Multi-target policy: VsTarget controls which VS SDK to compile against.
         Pass /p:VsTarget=vs2022 or /p:VsTarget=vs2026 on the command line.
         Default is vs2026 (current dev machine). Each target produces an
         independent VSIX loadable only on the corresponding VS version. -->
    <VsTarget Condition=" '$(VsTarget)' == '' ">vs2026</VsTarget>
    <VsWherePath Condition=" '$(VsWherePath)' == '' ">$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWherePath>
    <VsSdkAssembliesPath Condition=" '$(VsSdkAssembliesPath)' == '' ">C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\PublicAssemblies</VsSdkAssembliesPath>
    <!-- Generate pkgdef from [PackageRegistration]/[ProvideAutoLoad] attributes (we ship a real VS Package) -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!-- Produce the .vsix container via the VS SDK build tooling (full MSBuild only — not dotnet build) -->
    <GenerateVsixContainer>true</GenerateVsixContainer>
    <CopyVsixManifestToOutput>true</CopyVsixManifestToOutput>
    <!-- Import the VS SDK core targets (defines CreateVsixContainer/GeneratePkgDef). VSSDK.BuildTools.props sets VsSDKInstall to the package's tools folder. -->
    <CustomAfterMicrosoftCSharpTargets Condition="'$(VsSDKInstall)' != ''">$(VsSDKInstall)\Microsoft.VsSDK.targets</CustomAfterMicrosoftCSharpTargets>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- eval_csharp 编译开关：本地开发默认启用（动态 C# 执行，调试利器）；
       GitHub 发布管线（.github/workflows/release.yml）用 /p:EvalCsharpEnabled=false
       显式关闭，发布版 VSIX 完全不含 eval_csharp 代码（任意代码执行，不应进生产）。
       EvalCsharpFacade / eval_csharp 工具注册 / EnableEvalCsharp 开关 / 参数链路
       全部 #if EVAL_CSHARP 包裹。 -->
  <PropertyGroup>
    <EvalCsharpEnabled Condition=" '$(EvalCsharpEnabled)' == '' ">true</EvalCsharpEnabled>
    <DefineConstants Condition=" '$(EvalCsharpEnabled)' == 'true' ">$(DefineConstants);EVAL_CSHARP</DefineConstants>
  </PropertyGroup>

  <!-- 通过 Microsoft.VisualStudio.SDK 元包引用全套 VS SDK 程序集（Shell.15.0 / Interop /
       Threading / Framework / OLE.Interop 等），assembly version 固定为 17.x，不随编译机器
       VS 版本漂移。VS2026 兼容性模型确认使用 17.x API（无 v18 NuGet SDK 包）。
       PrivateAssets=all：不 copy-local、不打包进 VSIX，运行时走 host bindingRedirect。
       NuGet SDK 元包内部 Shell.15.0 引用 Threading 17.x → 无 CS1705（版本自洽）。
       VC 内部 DLL（CppSvc/CodeStore/VC.Interfaces）、NavigateTo、ComponentModelHost 不在
       元包内，仍从 host 手动引用（Private=false）。 -->
  <!-- SDK 元包拉进 Threading analyzers，VSTHRD002/010 是 thread-safety 检查。
       VsMcp 的 COM 调用已自行切 UI 线程，降级为 warning 避免编译失败。 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);VSTHRD002;VSTHRD010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.31902.203" PrivateAssets="all" />

    <!-- STJ/BCL/Encodings/LogAbstractions：NuGet 9.0.0（asm 9.0.0.0），在所有 VS 版本 redirect range 内 -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" ExcludeAssets="all" />
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" ExcludeAssets="all" />
  </ItemGroup>

  <!-- Discover VS install path via vswhere — 只用于不在 SDK 元包内的 DLL（VC internals、NavigateTo） -->
  <Target Name="ResolveVsSdkPath" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(VsSdkAssembliesPath)\Microsoft.VisualStudio.Shell.15.0.dll') And Exists('$(VsWherePath)')">
    <Exec Command='"$(VsWherePath)" -version "[17.0,18.0)" -property installationPath'
          ConsoleToMSBuild="true" Condition=" '$(VsTarget)' == 'vs2022' ">
      <Output TaskParameter="ConsoleOutput" PropertyName="_VsInstallPath" />
    </Exec>
    <Exec Command='"$(VsWherePath)" -version "[18.0,19.0)" -property installationPath'
          ConsoleToMSBuild="true" Condition=" '$(VsTarget)' == 'vs2026' ">
      <Output TaskParameter="ConsoleOutput" PropertyName="_VsInstallPath" />
    </Exec>
    <PropertyGroup Condition=" '$(_VsInstallPath)' != '' ">
      <VsSdkAssembliesPath>$(_VsInstallPath)\Common7\IDE\PublicAssemblies</VsSdkAssembliesPath>
    </PropertyGroup>
    <Error Text="[VsMcp] No Visual Studio installation found for VsTarget=$(VsTarget)" Condition=" '$(_VsInstallPath)' == '' " />
    <Message Text="[VsMcp] VsTarget=$(VsTarget) resolved via vswhere: $(VsSdkAssembliesPath)" Importance="high" Condition=" '$(_VsInstallPath)' != '' " />
  </Target>

  <!-- VS 内部 DLL 引用（不在 SDK 元包内，必须从 host 安装目录引用）。
       NavigateTo / CppSvc.Internal / CodeStore.Internal / VC.Interfaces / ComponentModelHost。 -->
  <Target Name="ResolveVsInternalReferences" BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="ResolveVsSdkPath">
    <PropertyGroup>
      <_VsIdePath Condition=" '$(_VsInstallPath)' != '' ">$(_VsInstallPath)\Common7\IDE</_VsIdePath>
      <_VsIdePath Condition=" '$(_VsIdePath)' == '' ">$(VsSdkAssembliesPath.Replace('\PublicAssemblies',''))</_VsIdePath>
    </PropertyGroup>
    <ItemGroup>
      <Reference Include="Microsoft.VisualStudio.Language.NavigateTo.Interfaces">
        <HintPath>$(_VsIdePath)\CommonExtensions\Microsoft\NavigateTo\Microsoft.VisualStudio.Language.NavigateTo.Interfaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.CppSvc.Internal">
        <HintPath>$(_VsIdePath)\PrivateAssemblies\Microsoft.VisualStudio.CppSvc.Internal.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.CodeStore.Internal">
        <HintPath>$(_VsIdePath)\PrivateAssemblies\Microsoft.VisualStudio.CodeStore.Internal.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.VC.Interfaces">
        <HintPath>$(_VsIdePath)\PublicAssemblies\Microsoft.VisualStudio.VC.Interfaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.VisualStudio.ComponentModelHost">
        <HintPath>$(_VsIdePath)\CommonExtensions\Platform\MefHosting\Microsoft.VisualStudio.ComponentModelHost.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- STJ/BCL/Encodings/LogAbstractions 编译引用指向 NuGet 9.0.0（Private=false 不打包） -->
      <Reference Include="System.Text.Json">
        <HintPath>$(NuGetPackageRoot)system.text.json\9.0.0\lib\netstandard2.0\System.Text.Json.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.Bcl.AsyncInterfaces">
        <HintPath>$(NuGetPackageRoot)microsoft.bcl.asyncinterfaces\9.0.0\lib\netstandard2.0\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="System.Text.Encodings.Web">
        <HintPath>$(NuGetPackageRoot)system.text.encodings.web\9.0.0\lib\netstandard2.0\System.Text.Encodings.Web.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Microsoft.Extensions.Logging.Abstractions">
        <HintPath>$(NuGetPackageRoot)microsoft.extensions.logging.abstractions\9.0.0\lib\netstandard2.0\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <!-- Memory/Buffers/Unsafe 等由 SDK 元包传递依赖提供（Private=false），不再从 host 手动引用。
           元包传递依赖的版本固定（如 Memory 4.6.0 → asm 4.0.2.0），在 host redirect range 内。 -->
      <Reference Include="System" />
      <Reference Include="System.Core" />
      <Reference Include="System.Net.Http" />
    </ItemGroup>
    <Message Text="[VsMcp] Internal refs from host, SDK refs from NuGet" Importance="high" />
  </Target>

  <!-- Pipe framing + protocol DTO source-link. The former VsMcp.Common DLL was
       removed because its NuGet-bound System.Text.Json version fought the VS
       host's codeBase-pinned version (FileLoadException on package load). The
       source is now compiled directly into VsMcp.dll (VS extension) and
       VsMcpGateway.exe (Gateway) so neither carries a shared DLL with strong-name
       / version / deployment constraints. The namespace stays VsMcp.Common, so
       every `using VsMcp.Common;` in this project resolves unchanged. -->
  <ItemGroup>
    <Compile Include="..\VsMcp.Common\PipeFraming.cs" Link="Common\PipeFraming.cs" />
    <Compile Include="..\VsMcp.Common\PipeProtocol.cs" Link="Common\PipeProtocol.cs" />
    <Compile Include="..\VsMcp.Common\ExtensionVersion.cs" Link="Common\ExtensionVersion.cs" />
  </ItemGroup>

  <!-- VsMcpGateway.exe is a separate WinExe process that owns :43210 and
       multiplexes MCP clients onto per-VS-instance pipes. It must ship inside
       this VSIX so that, after install, GatewayLauncher.ResolveGatewayPath's
       "same directory as the package dll" branch finds it next to VsMcp.dll.

       ReferenceOutputAssembly=false: VsMcp must NOT compile-link against the
       Gateway's types (different process; they only talk over pipes) — we use
       the ProjectReference purely to establish build ordering (Gateway must be
       built before VsMcp so its exe output exists for the Copy step below). -->
  <ItemGroup>
    <ProjectReference Include="..\VsMcpGateway\VsMcpGateway.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- After the Gateway project builds (driven by the ProjectReference above),
       copy its exe AND its generated .exe.config into VsMcp's output directory.
       The .exe.config is the SDK's auto-generated bindingRedirect output
       (AutoGenerateBindingRedirects=true), needed at runtime for any minor
       version unification inside the Gateway's own dependency graph. The
       bundled dependency dlls (System.Text.Json, System.Memory, etc.) come from
       VsMcp's own copy-local set, which — because VsMcp pins System.Text.Json
       10.0.9 directly — match Gateway's compile-time references, so the VSIX's
       single bundled System.Text.Json.dll satisfies both processes without
       extra manual bindingRedirects. -->
  <Target Name="CopyGatewayExe" AfterTargets="ResolveProjectReferences"
          BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <VsMcpGatewayOutputDir>$(MSBuildThisFileDirectory)..\VsMcpGateway\bin\$(Configuration)\net48\</VsMcpGatewayOutputDir>
      <VsMcpGatewayExePath>$(VsMcpGatewayOutputDir)VsMcpGateway.exe</VsMcpGatewayExePath>
      <VsMcpGatewayConfigPath>$(VsMcpGatewayOutputDir)VsMcpGateway.exe.config</VsMcpGatewayConfigPath>
      <!-- Gateway exe + 全套依赖 dll 放 VSIX 的 Gateway\ 子目录，与 VsMcp.dll 隔离：
           VsMcp.dll 的 CLR 会在 VSIX 根目录探测依赖，若根目录有 Gateway 自带的高版本
           System.Text.Json / Microsoft.Extensions.*（超出 host bindingRedirect range），
           会与 host redirect 的 newVersion 版本不匹配，导致 FileLoadException 0x80131040
           （VS 包 SetSite 失败）。子目录不是 CLR private probing path，根目录探测看不到它们，
           VsMcp.dll 转而走 host bindingRedirect 的 codeBase；Gateway 进程用自己子目录里的 dll。 -->
      <GatewayDestDir>$(TargetDir)Gateway\</GatewayDestDir>
    </PropertyGroup>
    <Copy SourceFiles="$(VsMcpGatewayExePath)"
          DestinationFolder="$(GatewayDestDir)"
          Condition="Exists('$(VsMcpGatewayExePath)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(VsMcpGatewayConfigPath)"
          DestinationFolder="$(GatewayDestDir)"
          Condition="Exists('$(VsMcpGatewayConfigPath)')"
          SkipUnchangedFiles="true" />
    <Message Text="Copied VsMcpGateway.exe + .exe.config -> $(GatewayDestDir)" Importance="high"
             Condition="Exists('$(VsMcpGatewayExePath)')" />
    <Warning Text="VsMcpGateway.exe not found at $(VsMcpGatewayExePath) — Gateway will be MISSING from the VSIX"
             Condition="!Exists('$(VsMcpGatewayExePath)')" />
  </Target>

  <!-- source.extension.vsixmanifest is auto-detected by VSSDK.BuildTools; no explicit include needed -->

  <!--
    Force-include Gateway-side runtime files into the VSIX root next to
    VsMcpGateway.exe. These are NOT for the VS extension itself: VsMcp.dll runs
    inside the VS host, whose devenv.exe.config codeBase already pins
    System.Text.Json / System.Memory / etc. from VS SharedAssemblies. The VS
    extension loader honors the host codeBase and ignores these copies.

    The Gateway is a SEPARATE process (VsMcpGateway.exe) and needs its own
    private copies of these dlls + its .exe.config (bindingRedirects that the
    Gateway's GenerateBindingRedirectsOutputType produces) to launch
    successfully. After VSIX install everything lands in one directory, so the
    Gateway exe finds its config and dependencies next to itself.
    Must run before GetVsixSourceItems; Link= forces VSIX-root placement.
  -->
  <Target Name="ForceIncludeRuntimeDependencies" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <VsMcpGatewayOutputDir>$(MSBuildThisFileDirectory)..\VsMcpGateway\bin\$(Configuration)\net48\</VsMcpGatewayOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- VsMcpGateway.exe + .exe.config 从 $(TargetDir)Gateway\（CopyGatewayExe 已拷来），打包进
           VSIX 的 Gateway\ 子目录。config 必带：否则 Gateway 启动 System.Memory 4.0.2.0 vs 4.0.5.0 FileLoadException。 -->
      <Content Include="$(TargetDir)Gateway\VsMcpGateway.exe" Condition="Exists('$(TargetDir)Gateway\VsMcpGateway.exe')">
        <IncludeInVSIX>true</IncludeInVSIX><Link>Gateway\VsMcpGateway.exe</Link>
      </Content>
      <Content Include="$(TargetDir)Gateway\VsMcpGateway.exe.config" Condition="Exists('$(TargetDir)Gateway\VsMcpGateway.exe.config')">
        <IncludeInVSIX>true</IncludeInVSIX><Link>Gateway\VsMcpGateway.exe.config</Link>
      </Content>
      <!-- Gateway 运行时依赖打包进 Gateway\ 子目录（隔离于 VsMcp.dll 的根目录：若这些高版本
           System.Text.Json / Microsoft.Extensions.* 与 VsMcp.dll 同在根目录，会超出 host
           bindingRedirect range 触发 0x80131040）。Gateway 是独立进程，自带 MCP/STJ 10.0.9 +
           传递依赖全套，运行时用子目录里的副本；VsMcp.dll 用 host 的 polyfill（codeBase 优先）。 -->
      <Content Include="$(VsMcpGatewayOutputDir)*.dll">
        <IncludeInVSIX>true</IncludeInVSIX><Link>Gateway\%(Filename)%(Extension)</Link>
      </Content>
    </ItemGroup>
    <Message Text="ForceIncludeRuntimeDependencies: bundling Gateway runtime deps into Gateway\ subdir from $(VsMcpGatewayOutputDir)" Importance="high" />
  </Target>

  <!-- 单一真相源：把 Directory.Build.props 的 $(VsMcpVersion) 注入选中的 vsixmanifest 的
       Identity Version（仅改复制出来的无后缀 manifest，源 .vs2022/.vs2026 占位值不动），
       消除 manifest 与代码版本号各自维护的漂移。RoslynCodeTaskFactory 经 MSBuild 自带
       的 Microsoft.Build.Tasks.Core.dll 加载（VS2022/VS2026 MSBuild 17/18 均支持）。 -->
  <UsingTask TaskName="PatchManifestVersion" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!System.IO.File.Exists(ManifestPath)) return true;
        string content = System.IO.File.ReadAllText(ManifestPath);
        string pattern = "(<Identity\\s[^>]*?\\sVersion=\")[^\"]*(\")";
        string patched = System.Text.RegularExpressions.Regex.Replace(content, pattern,
            m => m.Groups[1].Value + Version + m.Groups[2].Value);
        if (patched != content) System.IO.File.WriteAllText(ManifestPath, patched);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Select the version-specific vsixmanifest based on VsTarget.
       VSSDK.BuildTools auto-detects "source.extension.vsixmanifest" by name,
       so we copy the target-specific file to that canonical name before it runs,
       then inject the single-source $(VsMcpVersion) into its Identity Version. -->
  <Target Name="SelectManifest" BeforeTargets="FindSourceVsixManifest">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)source.extension.vsixmanifest.$(VsTarget)"
          DestinationFiles="$(MSBuildThisFileDirectory)source.extension.vsixmanifest"
          SkipUnchangedFiles="false"
          Condition="Exists('$(MSBuildThisFileDirectory)source.extension.vsixmanifest.$(VsTarget)')" />
    <PatchManifestVersion ManifestPath="$(MSBuildThisFileDirectory)source.extension.vsixmanifest"
                          Version="$(VsMcpVersion)"
                          Condition="Exists('$(MSBuildThisFileDirectory)source.extension.vsixmanifest')" />
    <Message Text="[VsMcp] Selected manifest for VsTarget=$(VsTarget), Version=$(VsMcpVersion)" Importance="high" />
  </Target>

  <!-- Rename the VSIX output to include the target suffix so both versions
       can coexist in the same output directory. -->
  <Target Name="RenameVsixByTarget" AfterTargets="CreateVsixContainer"
          Condition=" '$(VsTarget)' != '' And '$(TargetVsixContainer)' != '' ">
    <Move SourceFiles="$(TargetVsixContainer)"
          DestinationFiles="$(TargetDir)VsMcp-$(VsTarget).vsix" />
    <Message Text="[VsMcp] Renamed VSIX -> VsMcp-$(VsTarget).vsix" Importance="high" />
  </Target>

</Project>
